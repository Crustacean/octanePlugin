<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="${it.displayName}">
    <l:main-panel>
      <style>
        .octane-report {
          max-width: 100%;
        }
        .octane-report h1 {
          margin-bottom: 0.25rem;
        }
        .octane-muted {
          color: var(--text-color-secondary);
        }
        .octane-visually-hidden:where(:not(:focus-within, :active)) {
          border: 0 !important;
          clip-path: inset(50%) !important;
          height: 1px !important;
          margin: -1px !important;
          overflow: hidden !important;
          padding: 0 !important;
          position: absolute !important;
          white-space: nowrap !important;
          width: 1px !important;
        }
        .octane-live-update {
          display: inline;
          margin-left: 0.35rem;
          white-space: nowrap;
        }
        .octane-live-update-last-updated {
          text-transform: uppercase;
        }
        .octane-dashboard {
          align-items: stretch;
          display: flex;
          flex-wrap: wrap;
          gap: 1rem;
          margin-top: 1rem;
        }
        .octane-timer-zone,
        .octane-report-zone {
          align-items: stretch;
          border: 1px solid var(--background);
          border-radius: 8px;
          box-sizing: border-box;
          display: flex;
          flex-wrap: wrap;
          gap: 1rem;
          padding: 1.5rem 1rem 1rem;
          position: relative;
          width: 100%;
        }
        .octane-zone-focus-toggle {
          align-items: center;
          appearance: none;
          background: transparent;
          border: 0;
          border-radius: 4px;
          color: var(--text-color-secondary);
          cursor: pointer;
          display: inline-flex;
          height: 1.15rem;
          justify-content: center;
          padding: 0;
          position: absolute;
          right: 0.35rem;
          top: 0.2rem;
          width: 1.15rem;
          z-index: 2;
        }
        .octane-zone-focus-toggle:hover {
          background: var(--panel-border-color);
          color: var(--text-color);
        }
        .octane-zone-focus-toggle:focus-visible,
        .octane-expand-toggle:focus-visible,
        .octane-view-toggle:focus-visible,
        .octane-card-tools:focus-visible,
        .octane-suite-column:focus-visible {
          outline: 3px solid #4391F5;
          outline-offset: 3px;
        }
        .octane-timer-zone.octane-zone-focused,
        .octane-report-zone.octane-zone-focused {
          background: var(--background);
          border-color: #4391F5;
          border-radius: 14px;
          box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.22);
          box-sizing: border-box;
          display: grid;
          gap: 1rem;
          grid-auto-rows: minmax(0, 1fr);
          grid-auto-flow: row;
          height: auto;
          inset: 1rem;
          max-height: none;
          max-width: none;
          overflow: hidden;
          padding: 1rem;
          position: fixed;
          width: auto;
          z-index: 9999;
        }
        .octane-timer-zone.octane-zone-focused {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .octane-timer-zone.octane-zone-focused > .octane-chart-card:nth-of-type(3) {
          grid-column: 1;
          grid-row: 2;
        }
        .octane-timer-zone.octane-zone-focused > .octane-chart-card:nth-of-type(4) {
          grid-column: 2;
          grid-row: 2;
        }
        .octane-timer-zone.octane-zone-focused > .octane-chart-card:only-of-type {
          grid-column: 1 / -1;
        }
        .octane-report-zone.octane-zone-focused {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .octane-report-zone.octane-zone-focused > .octane-chart-card:nth-of-type(3) {
          grid-column: 1;
          grid-row: 2;
        }
        .octane-report-zone.octane-zone-focused > .octane-chart-card:nth-of-type(4) {
          grid-column: 2;
          grid-row: 2;
        }
        .octane-report-zone.octane-zone-focused > .octane-chart-card:only-of-type {
          grid-column: 1 / -1;
        }
        .octane-zone-focused .octane-chart-card {
          box-sizing: border-box;
          display: flex;
          flex-direction: column;
          height: 100%;
          max-width: 100%;
          min-height: 0;
          min-width: 0;
          padding: clamp(0.55rem, 1vw, 1rem);
          resize: none;
          width: auto;
        }
        .octane-zone-focused .octane-card-header,
        .octane-zone-focused .octane-flip-face-header {
          align-items: flex-start;
          flex: 0 1 auto;
          margin-bottom: clamp(0.25rem, 0.7vh, 0.65rem);
          min-height: 0;
        }
        .octane-zone-focused .octane-card-title {
          font-size: clamp(0.72rem, 1vw, 1rem);
          font-size: clamp(0.66rem, 2.6cqw, 1rem);
          line-height: 1.15;
        }
        .octane-report-zone.octane-zone-focused .octane-card-title {
          font-size: clamp(0.66rem, 2.6cqw, 0.85rem);
        }
        .octane-zone-focused .octane-distribution-meta,
        .octane-zone-focused .octane-suite-chart-meta {
          gap: 0.2rem 0.45rem;
        }
        .octane-zone-focused .octane-legend {
          gap: 0.2rem 0.45rem;
        }
        .octane-zone-focused .octane-legend-row,
        .octane-zone-focused .octane-total-label {
          font-size: clamp(0.58rem, 0.85vw, 0.82rem);
          font-size: clamp(0.52rem, 1.9cqw, 0.82rem);
        }
        .octane-report-zone.octane-zone-focused .octane-legend-row,
        .octane-report-zone.octane-zone-focused .octane-total-label {
          font-size: clamp(0.52rem, 1.9cqw, 0.697rem);
        }
        .octane-zone-focused .octane-swatch {
          height: clamp(0.45rem, 0.75vw, 0.7rem);
          width: clamp(0.45rem, 0.75vw, 0.7rem);
        }
        .octane-zone-focused .octane-timer-wrap,
        .octane-zone-focused .octane-flip-viewport,
        .octane-zone-focused .octane-flip-face-body,
        .octane-zone-focused .octane-donut-wrap,
        .octane-zone-focused .octane-bar-graph {
          flex: 1 1 auto;
          min-height: 0;
        }
        .octane-zone-focused .octane-donut-wrap {
          box-sizing: border-box;
          overflow: visible;
          padding: clamp(0.25rem, 1vh, 0.75rem) clamp(0.5rem, 1.2vw, 1.5rem);
          width: 100%;
        }
        .octane-zone-focused .octane-timer-donut {
          max-height: min(38vh, 38vw);
          max-width: min(38vh, 38vw);
        }
        .octane-zone-focused .octane-risk-heat-map {
          height: min(100cqw, 100cqh, 38vh, 38vw);
          max-height: min(38vh, 38vw);
          max-width: min(38vh, 38vw);
          width: min(100cqw, 100cqh, 38vh, 38vw);
        }
        .octane-zone-focused .octane-donut {
          height: 100%;
          max-height: 100%;
          max-width: 100%;
          width: 100%;
        }
        .octane-zone-focused .octane-bar-graph {
          --octane-axis-label-row: clamp(1.05rem, 2vh, 1.7rem);
          grid-template-columns: clamp(0.85rem, 1.2vw, 1.35rem) max-content minmax(0, 1fr);
          grid-template-rows: minmax(0, 1fr) var(--octane-axis-label-row);
          height: 100%;
          margin-top: clamp(0.25rem, 0.8vh, 0.75rem);
          row-gap: 0;
        }
        .octane-zone-focused .octane-y-axis-label {
          font-size: 12px;
        }
        .octane-zone-focused .octane-axis-value {
          font-size: 12px;
        }
        .octane-zone-focused .octane-suite-column {
          flex-basis: clamp(1.6rem, 7vw, 4.65rem);
          max-width: none;
        }
        .octane-zone-focused .octane-vertical-bar {
          width: min(clamp(0.715rem, 70.2%, 3.12rem), calc(100% - 0.1rem));
        }
        .octane-zone-focused .octane-suite-label {
          font-size: 12px;
          max-width: 100%;
          padding-top: clamp(0.04rem, 0.25vh, 0.16rem);
        }
        .octane-zone-focused .octane-card-tools {
          cursor: grab;
        }
        .octane-chart-card {
          background: var(--background);
          border: 1px solid var(--input-border);
          border-radius: 14px;
          box-sizing: border-box;
          box-shadow: 0 1px 7px rgba(0, 0, 0, 0.14);
          contain: layout style paint;
          container-type: inline-size;
          flex: 0 1 calc(50% - 0.5rem);
          min-height: 310px;
          min-width: 360px;
          overflow-x: hidden;
          overflow-y: hidden;
          padding: 1rem;
          resize: horizontal;
          width: calc(50% - 0.5rem);
        }
        .octane-chart-card:active {
          cursor: grabbing;
        }
        .octane-card-header {
          align-items: center;
          display: flex;
          gap: clamp(0.35rem, 1.8cqw, 0.75rem);
          justify-content: space-between;
          margin-bottom: clamp(0.35rem, 2cqw, 0.75rem);
        }
        .octane-card-header > div:first-child {
          min-width: 0;
        }
        .octane-card-title {
          font-size: clamp(0.78rem, 1vw, 1rem);
          font-size: clamp(0.72rem, 3.2cqw, 1.08rem);
          font-weight: 600;
          line-height: 1.15;
          margin: 0;
          overflow-wrap: anywhere;
        }
        .octane-card-header .octane-muted,
        .octane-flip-face-header .octane-muted,
        .octane-total-label,
        .octane-legend-row {
          font-size: clamp(0.62rem, 0.9vw, 0.88rem);
          font-size: clamp(0.58rem, 2.35cqw, 0.9rem);
          line-height: 1.2;
        }
        .octane-report-zone .octane-card-title {
          font-size: clamp(0.72rem, 3.2cqw, 0.918rem);
        }
        .octane-report-zone .octane-card-header .octane-muted,
        .octane-report-zone .octane-total-label,
        .octane-report-zone .octane-legend-row {
          font-size: clamp(0.58rem, 2.35cqw, 0.765rem);
        }
        .octane-card-actions {
          align-items: center;
          display: inline-flex;
          flex: 0 0 auto;
          gap: 0.45rem;
        }
        .octane-expand-toggle,
        .octane-view-toggle {
          align-items: center;
          appearance: none;
          background: transparent;
          border: 0;
          border-radius: 4px;
          color: var(--text-color-secondary);
          cursor: pointer;
          display: inline-flex;
          height: 1.15rem;
          justify-content: center;
          padding: 0;
          width: 1.15rem;
        }
        .octane-expand-toggle:hover,
        .octane-view-toggle:hover {
          background: var(--panel-border-color);
          color: var(--text-color);
        }
        .octane-action-icon {
          display: block;
          fill: none;
          height: 0.95rem;
          stroke: currentColor;
          stroke-linecap: round;
          stroke-linejoin: round;
          stroke-width: 1.8;
          width: 0.95rem;
        }
        .octane-icon-collapse {
          display: none;
        }
        .octane-icon-timer {
          display: none;
        }
        .octane-chart-card[data-active-view="heatmap"] .octane-icon-heatmap {
          display: none;
        }
        .octane-chart-card[data-active-view="metrics"] .octane-icon-metrics {
          display: none;
        }
        .octane-chart-card[data-active-view="heatmap"] .octane-icon-timer {
          display: block;
        }
        .octane-chart-card[data-active-view="metrics"] .octane-icon-timer {
          display: block;
        }
        .octane-chart-card[data-card-key="timer-timeout"],
        .octane-chart-card[data-card-key="timer-poll"] {
          display: flex;
          flex-direction: column;
          position: relative;
        }
        .octane-chart-card[data-card-key="timer-poll"][data-active-view="heatmap"] {
          padding-bottom: clamp(0.45rem, 0.8cqw, 0.7rem);
        }
        .octane-chart-card[data-card-key="timer-poll"][data-active-view="heatmap"]
          .octane-flip-viewport {
          min-height: 0;
        }
        .octane-chart-card[data-card-key="timer-timeout"] > .octane-card-actions,
        .octane-chart-card[data-card-key="timer-poll"] > .octane-card-actions {
          position: absolute;
          right: 1rem;
          top: 1rem;
          z-index: 3;
        }
        .octane-flip-viewport {
          box-sizing: border-box;
          display: flex;
          flex: 1 1 auto;
          min-height: 245px;
          min-width: 0;
          overflow: hidden;
          position: relative;
          width: 100%;
        }
        .octane-flip-face {
          box-sizing: border-box;
          display: grid;
          grid-template-rows: auto minmax(0, 1fr);
          inset: 0;
          min-height: 0;
          min-width: 0;
          opacity: 0;
          pointer-events: none;
          position: absolute;
          transform: translateY(0.25rem);
          transition: opacity 160ms ease, transform 160ms ease;
          width: 100%;
        }
        .octane-chart-card[data-active-view="timer"] .octane-flip-face-timer,
        .octane-chart-card[data-active-view="heatmap"] .octane-flip-face-heatmap,
        .octane-chart-card[data-active-view="metrics"] .octane-flip-face-metrics {
          opacity: 1;
          pointer-events: auto;
          transform: translateY(0);
        }
        .octane-flip-face-header {
          align-items: flex-start;
          display: flex;
          flex-wrap: wrap;
          gap: 0.35rem 0.75rem;
          justify-content: space-between;
          min-width: 0;
          padding-right: 4.5rem;
        }
        .octane-flip-face-header > div:first-child {
          min-width: 0;
        }
        .octane-flip-face-body {
          align-items: center;
          display: flex;
          justify-content: center;
          min-height: 0;
          min-width: 0;
          overflow: hidden;
          width: 100%;
        }
        .octane-chart-card[data-card-key="timer-poll"][data-active-view="heatmap"]
          .octane-flip-face-body {
          align-items: stretch;
        }
        .octane-chart-card[data-card-key="timer-timeout"][data-active-view="metrics"]
          .octane-flip-face-body {
          align-items: stretch;
          justify-content: stretch;
        }
        .octane-heatmap-subtitle-row {
          align-items: center;
          display: flex;
          flex-wrap: wrap;
          gap: 0.24rem 0.45rem;
        }
        .octane-heatmap-inline-legend {
          align-items: center;
          display: inline-flex;
          flex-wrap: wrap;
          gap: 0.24rem 0.45rem;
        }
        .octane-heatmap-inline-legend .octane-legend-row {
          white-space: nowrap;
        }
        .octane-heatmap-inline-legend .octane-swatch {
          height: 0.56rem;
          width: 0.56rem;
        }
        .octane-zone-focused .octane-heatmap-inline-legend .octane-swatch {
          height: clamp(0.32rem, 0.52vw, 0.49rem);
          width: clamp(0.32rem, 0.52vw, 0.49rem);
        }
        .octane-risk-heat-map-panel-inner {
          align-content: stretch;
          align-items: center;
          display: grid;
          gap: clamp(0.35rem, 1vh, 0.65rem);
          grid-template-columns: minmax(0, 1fr);
          grid-template-rows: minmax(0, 1fr) max-content;
          height: 100%;
          justify-items: stretch;
          min-height: 0;
          width: 100%;
        }
        .octane-risk-heat-map-container {
          align-items: center;
          box-sizing: border-box;
          container-type: size;
          display: flex;
          height: 100%;
          justify-content: center;
          min-height: 0;
          overflow: hidden;
          width: 100%;
        }
        .octane-risk-issues-container {
          align-items: center;
          align-self: end;
          box-sizing: border-box;
          display: flex;
          justify-content: center;
          min-width: 0;
          padding-top: clamp(0.2rem, 0.8vh, 0.55rem);
          width: 100%;
        }
        .octane-risk-heat-map {
          aspect-ratio: 1;
          border-radius: 50%;
          box-sizing: border-box;
          clip-path: circle(50% at 50% 50%);
          display: block;
          height: auto;
          height: min(100cqw, 100cqh, 220px);
          max-height: min(100%, 220px);
          max-width: 220px;
          overflow: hidden;
          shape-rendering: geometricPrecision;
          width: min(100%, 220px);
          width: min(100cqw, 100cqh, 220px);
        }
        .octane-risk-heat-map-slice {
          stroke: var(--background);
          stroke-width: 1;
        }
        .octane-risk-heat-map-center {
          fill: var(--background);
          stroke: var(--panel-border-color);
          stroke-width: 1;
        }
        .octane-risk-heat-map-score {
          fill: var(--text-color);
          font-size: 2rem;
          font-weight: 700;
          text-anchor: middle;
        }
        .octane-risk-heat-map-label {
          fill: var(--text-color-secondary);
          font-size: 0.85rem;
          text-anchor: middle;
        }
        .octane-test-metrics-grid {
          box-sizing: border-box;
          display: grid;
          gap: 0;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          grid-template-rows: repeat(2, minmax(0, 1fr));
          height: 100%;
          min-height: 0;
          overflow: hidden;
          width: 100%;
        }
        .octane-test-metric-card {
          align-items: center;
          background: rgba(48, 54, 61, 0.28);
          border: 1px solid var(--input-border);
          border-radius: 0;
          box-sizing: border-box;
          container-type: size;
          display: flex;
          flex-direction: column;
          justify-content: center;
          min-height: 0;
          min-width: 0;
          overflow: hidden;
          padding: clamp(0.25rem, 1.1vmin, 2rem);
          text-align: center;
        }
        .octane-test-metric-card:nth-child(3) {
          border-bottom-left-radius: 14px;
        }
        .octane-test-metric-card:nth-child(4) {
          border-bottom-right-radius: 14px;
        }
        .octane-test-metric-heading {
          align-items: center;
          color: var(--text-color);
          display: inline-flex;
          font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
          font-size: clamp(0.54rem, min(2.85cqw, 3cqh), 1.75rem);
          font-weight: 500;
          gap: clamp(0.2rem, min(1.1cqw, 1.1cqh), 0.8rem);
          justify-content: center;
          letter-spacing: clamp(0.01em, 0.36cqw, 0.2em);
          line-height: 1.12;
          min-width: 0;
          max-width: 98%;
          text-transform: uppercase;
          white-space: nowrap;
        }
        .octane-test-metric-heading span {
          min-width: 0;
          overflow-wrap: anywhere;
          white-space: nowrap;
        }
        .octane-test-metric-icon {
          fill: none;
          flex: 0 0 auto;
          height: clamp(1.05em, 1.55em, 2em);
          stroke: currentColor;
          stroke-linecap: round;
          stroke-linejoin: round;
          stroke-width: 2;
          width: clamp(1.05em, 1.55em, 2em);
        }
        .octane-test-metric-value {
          color: var(--text-color);
          font-family: "Hanken Grotesk", Inter, "Segoe UI", Arial, sans-serif;
          font-size: clamp(1.26rem, min(15.6cqw, 26.4cqh), 9.6rem);
          font-weight: 700;
          letter-spacing: 0;
          line-height: 0.95;
          margin-top: clamp(0.22rem, min(2.6cqw, 2.6cqh), 2.25rem);
          max-width: 98%;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        .octane-test-metric-detail,
        .octane-test-metric-trend {
          color: var(--text-color-secondary);
          font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
          font-size: clamp(0.6rem, min(3.0625cqw, 3.3125cqh), 1.9375rem);
          line-height: 1.14;
          margin-top: clamp(0.08rem, min(0.8cqw, 0.8cqh), 0.75rem);
          max-width: 98%;
          overflow: hidden;
          overflow-wrap: anywhere;
          text-overflow: ellipsis;
        }
        .octane-test-metric-trend {
          font-weight: 700;
        }
        @container (max-width: 16rem), (max-height: 10.5rem) {
          .octane-test-metric-heading {
            font-size: clamp(0.46rem, min(2.45cqw, 2.55cqh), 0.74rem);
            gap: clamp(0.14rem, 0.8cqw, 0.34rem);
            letter-spacing: clamp(0, 0.22cqw, 0.08em);
            line-height: 1.05;
            max-width: 100%;
          }
          .octane-test-metric-icon {
            height: 1.15em;
            width: 1.15em;
          }
          .octane-test-metric-value {
            font-size: clamp(1.14rem, min(12cqw, 21.6cqh), 2.94rem);
            line-height: 0.9;
            margin-top: clamp(0.08rem, min(1.1cqw, 1.1cqh), 0.32rem);
          }
          .octane-test-metric-detail,
          .octane-test-metric-trend {
            font-size: clamp(0.55rem, min(2.75cqw, 2.8125cqh), 0.9rem);
            line-height: 1.08;
            margin-top: clamp(0.04rem, min(0.55cqw, 0.55cqh), 0.18rem);
            max-width: 100%;
          }
        }
        @container (max-width: 12rem), (max-height: 8.25rem) {
          .octane-test-metric-heading {
            font-size: clamp(0.4rem, min(2.15cqw, 2.2cqh), 0.58rem);
            letter-spacing: 0;
          }
          .octane-test-metric-value {
            font-size: clamp(0.984rem, min(10.2cqw, 18cqh), 1.98rem);
          }
          .octane-test-metric-detail,
          .octane-test-metric-trend {
            font-size: clamp(0.475rem, min(2.375cqw, 2.5cqh), 0.725rem);
            line-height: 1.05;
          }
        }
        .octane-test-metric-trend-positive {
          color: #7BE5B3;
        }
        .octane-test-metric-trend-negative {
          color: #ff6361;
        }
        .octane-defect-severity-tracker {
          container-type: inline-size;
          display: flex;
          flex-direction: column;
          gap: clamp(0.16rem, 0.4cqw, 0.32rem);
          width: 75%;
        }
        .octane-defect-severity-bar {
          border-radius: 0;
          display: grid;
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: 0.875em;
          font-weight: 500;
          gap: 0;
          grid-template-columns: repeat(7, minmax(0, 1fr));
          line-height: 1.35;
          min-height: clamp(2.58em, 3.4cqw, 4.25em);
          overflow: hidden;
          text-align: center;
          width: 100%;
        }
        .octane-defect-severity-segment {
          align-items: center;
          color: #ffffff;
          display: inline-flex;
          gap: 0.28em;
          justify-content: center;
          min-width: 0;
          overflow: hidden;
          padding: 0.45em 0.55em;
          white-space: nowrap;
        }
        .octane-defect-severity-count {
          color: inherit;
          display: inline-block;
          flex: 0 0 auto;
          min-width: 2ch;
          text-align: right;
        }
        .octane-defect-severity-label {
          color: inherit;
          display: inline-block;
          min-width: 0;
          overflow: visible;
          text-overflow: clip;
        }
        .octane-defect-severity-meta {
          color: var(--text-color-secondary);
          display: flex;
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: clamp(0.58rem, 1.45cqw, 0.78rem);
          font-weight: 500;
          gap: 0.75rem;
          justify-content: space-between;
          letter-spacing: 0;
          text-transform: uppercase;
          width: 100%;
        }
        @container (max-width: 44rem) {
          .octane-defect-severity-label {
            display: none;
          }
          .octane-defect-severity-count {
            min-width: auto;
            text-align: center;
          }
        }
        .octane-risk-heat-map-empty {
          align-items: center;
          border: 1px dashed var(--input-border);
          border-radius: 8px;
          color: var(--text-color-secondary);
          display: flex;
          height: 100%;
          justify-content: center;
          min-height: 0;
          padding: 1rem;
          text-align: center;
          width: 100%;
        }
        .octane-card-tools {
          align-items: center;
          appearance: none;
          background: transparent;
          border: 0;
          border-radius: 4px;
          color: var(--text-color-secondary);
          cursor: grab;
          display: inline-flex;
          font-size: 0;
          height: 1.15rem;
          justify-content: center;
          letter-spacing: 0;
          line-height: 1;
          overflow: hidden;
          padding: 0;
          user-select: none;
          width: 1.15rem;
        }
        .octane-card-tools:hover {
          background: var(--panel-border-color);
          color: var(--text-color);
        }
        .octane-grabber-icon {
          display: block;
          fill: currentColor;
          height: 0.95rem;
          opacity: 0.92;
          width: 0.95rem;
        }
        .octane-chart-card.octane-dragging {
          border-color: #4391F5;
          opacity: 0.45;
        }
        .octane-expanded-backdrop {
          background: rgba(0, 0, 0, 0.42);
          inset: 0;
          position: fixed;
          z-index: 9998;
        }
        .octane-chart-card.octane-expanded {
          border-color: #4391F5;
          display: flex;
          flex-direction: column;
          height: auto;
          inset: 1rem;
          max-height: none;
          max-width: none;
          min-height: 0;
          min-width: 0;
          overflow: hidden;
          position: fixed;
          resize: none;
          width: auto;
          z-index: 9999;
        }
        .octane-chart-card.octane-expanded .octane-icon-expand {
          display: none;
        }
        .octane-chart-card.octane-expanded .octane-icon-collapse {
          display: block;
        }
        .octane-chart-card.octane-expanded .octane-card-header,
        .octane-chart-card.octane-expanded .octane-flip-face-header {
          flex: 0 0 auto;
        }
        .octane-chart-card.octane-expanded .octane-card-title {
          font-size: clamp(0.9rem, 1.5vw, 1.3rem);
          font-size: clamp(0.9rem, 2.2cqw, 1.3rem);
        }
        .octane-report-zone .octane-chart-card.octane-expanded .octane-card-title {
          font-size: clamp(0.765rem, 2.2cqw, 1.105rem);
        }
        .octane-chart-card.octane-expanded .octane-muted,
        .octane-chart-card.octane-expanded .octane-total-label {
          font-size: clamp(0.72rem, 1vw, 0.95rem);
          font-size: clamp(0.72rem, 1.5cqw, 0.95rem);
        }
        .octane-report-zone .octane-chart-card.octane-expanded .octane-muted,
        .octane-report-zone .octane-chart-card.octane-expanded .octane-total-label,
        .octane-report-zone .octane-chart-card.octane-expanded .octane-legend-row {
          font-size: clamp(0.612rem, 1.5cqw, 0.808rem);
        }
        .octane-chart-card.octane-expanded .octane-timer-wrap,
        .octane-chart-card.octane-expanded .octane-flip-viewport,
        .octane-chart-card.octane-expanded .octane-flip-face-body,
        .octane-chart-card.octane-expanded .octane-donut-wrap,
        .octane-chart-card.octane-expanded .octane-bar-graph {
          flex: 1 1 auto;
          min-height: 0;
        }
        .octane-chart-card.octane-expanded .octane-timer-donut {
          max-height: min(76vh, 76vw);
          max-width: min(76vh, 76vw);
        }
        .octane-chart-card.octane-expanded .octane-risk-heat-map {
          height: min(100cqw, 100cqh, 76vh, 76vw);
          max-height: min(76vh, 76vw);
          max-width: min(76vh, 76vw);
          width: min(100cqw, 100cqh, 76vh, 76vw);
        }
        .octane-chart-card.octane-expanded .octane-donut {
          max-height: min(72vh, 72vw);
          max-width: min(72vh, 72vw);
        }
        .octane-chart-card.octane-expanded .octane-bar-graph {
          --octane-axis-label-row: 1.7rem;
          grid-template-rows: minmax(0, 1fr) var(--octane-axis-label-row);
        }
        .octane-chart-card.octane-expanded .octane-card-tools {
          cursor: default;
        }
        .octane-timer-card {
          flex: 1 1 calc(25% - 0.75rem);
          min-height: 280px;
          min-width: 280px;
          width: calc(25% - 0.75rem);
        }
        .octane-timer-wrap {
          align-items: center;
          display: flex;
          justify-content: center;
          min-height: 215px;
        }
        .octane-timer-donut {
          display: block;
          height: auto;
          max-width: 220px;
          overflow: visible;
          shape-rendering: geometricPrecision;
          width: 100%;
        }
        .octane-timer-track {
          fill: none;
          opacity: 0.5;
          stroke: var(--panel-border-color);
          stroke-width: 4;
        }
        .octane-timer-progress-halo {
          fill: none;
          opacity: 0.22;
          stroke-linecap: round;
          stroke-width: 20;
        }
        .octane-timer-progress {
          fill: none;
          filter: drop-shadow(0 0 1px rgba(30, 167, 255, 0.35));
          stroke-linecap: round;
          stroke-width: 16;
        }
        .octane-timer-head {
          transition: fill 0.25s ease;
        }
        .octane-timer-value {
          fill: var(--text-color);
          font-size: 2.6082rem;
          font-weight: 700;
          text-anchor: middle;
        }
        .octane-timer-unit {
          fill: var(--text-color-secondary);
          font-size: 0.91875rem;
          text-anchor: middle;
        }
        .octane-donut-wrap {
          align-items: center;
          display: flex;
          gap: 0.75rem;
          justify-content: center;
          padding: 0.75rem 1.5rem;
        }
        .octane-donut {
          display: block;
          height: auto;
          justify-self: center;
          max-width: 280px;
          overflow: visible;
          width: 100%;
        }
        .octane-donut-label {
          fill: var(--text-color);
          font-size: 0.28rem;
          font-weight: 700;
          pointer-events: none;
          text-anchor: middle;
        }
        .octane-donut-hole {
          fill: var(--background);
        }
        .octane-distribution-meta {
          align-items: center;
          display: flex;
          flex-wrap: wrap;
          gap: 0.35rem 0.75rem;
          margin-top: 0.25rem;
        }
        .octane-total-label {
          color: var(--text-color-secondary);
        }
        .octane-suite-chart-meta {
          align-items: center;
          display: flex;
          flex-wrap: wrap;
          gap: 0.35rem 0.75rem;
          margin-top: 0.25rem;
        }
        .octane-axis-value {
          color: #827C7B;
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: 12px;
          font-weight: 400;
        }
        .octane-bar-graph {
          --octane-axis-label-row: 1.7rem;
          box-sizing: border-box;
          column-gap: 0.09rem;
          display: grid;
          grid-template-columns: 1.35rem max-content minmax(0, 1fr);
          grid-template-rows: 260px var(--octane-axis-label-row);
          margin-top: 1rem;
          row-gap: 0;
          width: 100%;
        }
        .octane-y-axis-label {
          align-self: center;
          color: #827C7B;
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: 12px;
          font-weight: 400;
          grid-column: 1;
          grid-row: 1;
          justify-self: center;
          transform: rotate(180deg);
          white-space: nowrap;
          writing-mode: vertical-rl;
        }
        .octane-y-axis-scale {
          align-items: end;
          display: flex;
          flex-direction: column;
          grid-column: 2;
          grid-row: 1;
          justify-content: space-between;
          min-width: 0;
          padding-right: 0.2rem;
        }
        .octane-bar-plot {
          box-sizing: border-box;
          grid-column: 3;
          grid-row: 1 / span 2;
          min-width: 0;
          overflow: visible;
          position: relative;
        }
        .octane-bar-plot::before {
          background-image: radial-gradient(
            circle,
            rgba(33, 38, 45, 0.92) 0 1px,
            transparent 1.2px
          );
          background-size: 0.55rem calc(100% / var(--octane-grid-line-count, 4));
          bottom: var(--octane-axis-label-row);
          content: "";
          left: 0;
          pointer-events: none;
          position: absolute;
          right: 0;
          top: 0;
          z-index: 0;
        }
        .octane-bar-plot::after {
          background: #30363D;
          bottom: var(--octane-axis-label-row);
          content: "";
          height: 1px;
          left: 0;
          pointer-events: none;
          position: absolute;
          right: 0;
          z-index: 0;
        }
        .octane-legend {
          align-items: center;
          display: flex;
          flex-wrap: wrap;
          gap: 0.35rem 0.65rem;
        }
        .octane-legend-row {
          align-items: center;
          display: inline-flex;
          column-gap: 0.35rem;
          white-space: nowrap;
        }
        .octane-swatch {
          border-radius: 2px;
          display: inline-block;
          height: 0.8rem;
          width: 0.8rem;
        }
        .octane-vertical-bars {
          align-items: stretch;
          box-sizing: border-box;
          display: flex;
          gap: clamp(0.15rem, 1vw, 1rem);
          height: 100%;
          justify-content: center;
          min-height: 0;
          overflow-x: hidden;
          overflow-y: visible;
          padding: 0 clamp(0.15rem, 0.7vw, 0.5rem);
          width: 100%;
        }
        .octane-vertical-bars::before,
        .octane-vertical-bars::after {
          content: "";
          display: none;
        }
        .octane-suite-column {
          align-items: center;
          display: grid;
          flex: 1 1 4.65rem;
          grid-template-rows: minmax(0, 1fr) var(--octane-axis-label-row);
          height: 100%;
          justify-items: center;
          max-width: 5.2rem;
          min-width: 0;
          position: relative;
        }
        .octane-vertical-bar-wrap {
          align-items: end;
          display: flex;
          grid-row: 1;
          height: 100%;
          justify-content: center;
          min-height: 0;
          width: 100%;
          z-index: 1;
        }
        .octane-vertical-bar {
          align-items: stretch;
          align-self: end;
          background: var(--panel-border-color);
          border-radius: 0;
          display: flex;
          flex-direction: column-reverse;
          height: 100%;
          overflow: hidden;
          width: min(clamp(1.105rem, 80.6%, 3.38rem), calc(100% - 0.1rem));
        }
        .octane-bar-popup {
          background: var(--background);
          border: 1px solid var(--panel-border-color);
          border-radius: 8px;
          box-shadow: 0 0.45rem 1.4rem rgba(0, 0, 0, 0.18);
          color: var(--text-color);
          display: grid;
          font-size: 0.644rem;
          gap: 0.32rem;
          left: 0;
          max-width: min(18rem, calc(100vw - 1rem));
          min-width: 10.92rem;
          opacity: 0;
          padding: 0.5rem 0.6rem;
          pointer-events: none;
          position: fixed;
          top: 0;
          transition: opacity 90ms ease;
          visibility: hidden;
          will-change: left, top;
          z-index: 9999;
        }
        .octane-bar-popup.octane-bar-popup-visible {
          opacity: 1;
          visibility: visible;
        }
        .octane-bar-popup.octane-bar-popup-restoring {
          transition: none;
        }
        .octane-bar-popup-name {
          border-bottom: 1px solid var(--panel-border-color);
          font-weight: 700;
          line-height: 1.25;
          overflow-wrap: anywhere;
          padding-bottom: 0.32rem;
          white-space: normal;
        }
        .octane-bar-popup-row {
          align-items: center;
          display: grid;
          gap: 0.32rem;
          grid-template-columns: 0.55rem minmax(0, 1fr) auto auto;
        }
        .octane-bar-popup .octane-swatch {
          height: 0.55rem;
          width: 0.55rem;
        }
        .octane-bar-popup-label {
          overflow-wrap: anywhere;
          white-space: normal;
        }
        .octane-bar-popup-value,
        .octane-bar-popup-percent,
        .octane-bar-popup-total-value {
          font-weight: 700;
          text-align: right;
        }
        .octane-bar-popup-total {
          border-top: 1px solid var(--panel-border-color);
          display: flex;
          justify-content: space-between;
          padding-top: 0.32rem;
        }
        .octane-vertical-segment {
          display: block;
          width: 100%;
        }
        .octane-suite-label {
          align-self: start;
          box-sizing: border-box;
          display: block;
          color: #827C7B;
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: 12px;
          font-weight: 400;
          grid-row: 2;
          line-height: 1.1;
          max-width: min(100%, 6.8rem);
          min-height: 1rem;
          overflow: hidden;
          padding-top: 0.18rem;
          text-align: center;
          text-overflow: ellipsis;
          transform: none;
          transform-origin: center;
          white-space: nowrap;
          width: 100%;
        }
        .octane-chart-data-summary {
          border-collapse: collapse;
        }
        @supports not (font-size: 1cqw) {
          .octane-card-title {
            font-size: clamp(0.72rem, 1vw, 1rem);
          }
          .octane-card-header .octane-muted,
          .octane-flip-face-header .octane-muted,
          .octane-total-label,
          .octane-legend-row {
            font-size: clamp(0.58rem, 0.9vw, 0.88rem);
          }
          .octane-test-metric-heading {
            font-size: clamp(0.5rem, 1.1vw, 1rem);
          }
          .octane-test-metric-value {
            font-size: clamp(1.26rem, 7vw, 5rem);
          }
          .octane-test-metric-detail,
          .octane-test-metric-trend {
            font-size: clamp(0.6rem, 1.5vw, 1.25rem);
          }
        }
        @media (prefers-reduced-motion: reduce) {
          .octane-flip-face,
          .octane-bar-popup {
            transition: none !important;
          }
        }
        .octane-empty {
          border: 1px dashed var(--input-border);
          border-radius: 8px;
          color: var(--text-color-secondary);
          padding: 1rem;
        }
        @media (max-width: 840px) {
          .octane-chart-card {
            flex-basis: 100%;
            min-width: 280px;
            width: 100%;
          }
          .octane-report-zone.octane-zone-focused {
            grid-template-columns: minmax(0, 1fr);
          }
          .octane-timer-zone.octane-zone-focused {
            grid-template-columns: minmax(0, 1fr);
          }
          .octane-timer-zone.octane-zone-focused > .octane-chart-card:nth-of-type(3),
          .octane-timer-zone.octane-zone-focused > .octane-chart-card:nth-of-type(4),
          .octane-report-zone.octane-zone-focused > .octane-chart-card:nth-of-type(3),
          .octane-report-zone.octane-zone-focused > .octane-chart-card:nth-of-type(4) {
            grid-column: auto;
            grid-row: auto;
          }
          .octane-timer-card {
            flex-basis: 100%;
            width: 100%;
          }
          .octane-donut-wrap {
            justify-content: center;
          }
        }
      </style>
      <j:set var="snapshot" value="${it.snapshot}" />
      <div class="octane-report">
        <h1>Octane Gate Report</h1>
        <p class="octane-muted">
          State: <span data-report-state-label="true">${snapshot.stateLabel}</span> |
          Last update: <span data-report-updated-at="true">${snapshot.updatedAtText}</span>
        </p>
        <p data-report-message="true">${snapshot.message}</p>
        <j:if test="${snapshot.hasCriteria()}">
          <p><strong>Criteria:</strong> ${snapshot.criteria}</p>
        </j:if>

        <div class="octane-dashboard octane-card-zone" id="octane-dashboard"
            data-current-updated-at="${snapshot.updatedAt}"
            data-report-building="${snapshot.building}"
            data-snapshot-url="snapshot">
          <div id="octane-reorder-status" class="octane-visually-hidden"
              aria-live="polite" aria-atomic="true"></div>
          <div class="octane-timer-zone octane-card-zone" id="octane-timer-zone"
              data-zone-key="timers">
            <section class="octane-chart-card octane-timer-card" draggable="true"
                data-card-key="timer-timeout"
                data-octane-timer="timeout"
                data-total-seconds="${snapshot.timeoutSeconds}"
                data-started-at="${snapshot.startedAt}"
                data-updated-at="${snapshot.updatedAt}"
                data-active="${snapshot.building}"
                data-active-view="timer">
              <div class="octane-card-actions">
                <button class="octane-view-toggle" type="button"
                    data-target-view="metrics" data-target-view-label="test metrics"
                    aria-label="Show test metrics" title="Show test metrics">
                  <svg class="octane-action-icon octane-icon-metrics" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M4 19V5" />
                    <path d="M4 19h16" />
                    <path d="M8 15h2" />
                    <path d="M12 11h2" />
                    <path d="M16 7h2" />
                  </svg>
                  <svg class="octane-action-icon octane-icon-timer" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <circle cx="12" cy="13" r="8" />
                    <path d="M12 9v4l3 2" />
                    <path d="M9 2h6" />
                  </svg>
                </button>
                <button class="octane-expand-toggle" type="button" aria-label="Expand widget"
                    aria-expanded="false" title="Expand widget">
                  <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M8 4H4v4" />
                    <path d="M16 4h4v4" />
                    <path d="M20 16v4h-4" />
                    <path d="M8 20H4v-4" />
                  </svg>
                  <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M9 3v6H3" />
                    <path d="M3 9l6-6" />
                    <path d="M15 21v-6h6" />
                    <path d="M21 15l-6 6" />
                  </svg>
                </button>
                <button class="octane-card-tools" type="button"
                    aria-label="Move widget"
                    title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                  <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                      focusable="false">
                    <circle cx="12" cy="5" r="2" />
                    <circle cx="12" cy="12" r="2" />
                    <circle cx="12" cy="19" r="2" />
                  </svg>
                </button>
              </div>
              <div class="octane-flip-viewport">
                <div class="octane-flip-face octane-flip-face-timer" data-card-view="timer">
                  <div class="octane-flip-face-header">
                    <div>
                      <h2 class="octane-card-title" data-timeout-title="true">
                        ${snapshot.testingTimeTitle}
                      </h2>
                      <div class="octane-muted">Testing Session Timer</div>
                    </div>
                  </div>
                  <div class="octane-flip-face-body">
                    <div class="octane-timer-wrap">
                      <svg class="octane-timer-donut" viewBox="0 0 240 240" role="img"
                          aria-label="Testing time remaining">
                        <defs>
                          <linearGradient id="octane-timeout-gradient" x1="32" y1="208" x2="208"
                              y2="32" gradientUnits="userSpaceOnUse">
                            <stop data-timer-tail-stop="true" data-timer-gradient-stop="true"
                                offset="0%" stop-color="#4caf50" />
                            <stop data-timer-mid-stop="true" data-timer-gradient-stop="true"
                                offset="50%" stop-color="#449d48" />
                            <stop data-timer-head-stop="true" data-timer-gradient-stop="true"
                                offset="100%" stop-color="#3c8c40" />
                          </linearGradient>
                        </defs>
                        <circle class="octane-timer-track" cx="120" cy="120" r="84" />
                        <circle class="octane-timer-progress-halo" data-timer-progress-halo="true"
                            cx="120" cy="120" r="84" pathLength="100"
                            stroke="url(#octane-timeout-gradient)" stroke-dasharray="0 100"
                            transform="rotate(-90 120 120)" />
                        <circle class="octane-timer-progress" data-timer-progress="true"
                            cx="120" cy="120" r="84" pathLength="100"
                            stroke="url(#octane-timeout-gradient)" stroke-dasharray="0 100"
                            transform="rotate(-90 120 120)" />
                        <circle class="octane-timer-head" data-timer-head="true"
                            cx="120" cy="36" r="9.6" fill="#1f5fff" />
                        <text class="octane-timer-value" data-timer-value="true" x="120" y="118">
                          <j:choose>
                            <j:when test="${snapshot.building}">--</j:when>
                            <j:otherwise>${snapshot.testingTimeSpentMinutes}</j:otherwise>
                          </j:choose>
                        </text>
                        <text class="octane-timer-unit" data-timer-unit="true" x="120" y="132.4">
                          <j:choose>
                            <j:when test="${snapshot.building}">minutes</j:when>
                            <j:otherwise>${snapshot.testingTimeSpentUnit}</j:otherwise>
                          </j:choose>
                        </text>
                      </svg>
                    </div>
                  </div>
                </div>
                <div class="octane-flip-face octane-flip-face-metrics" data-card-view="metrics">
                  <div class="octane-flip-face-header">
                    <div>
                      <h2 class="octane-card-title">Test Metrics</h2>
                      <div class="octane-muted">Current Job Analytics</div>
                    </div>
                  </div>
                  <div class="octane-flip-face-body" data-test-metrics-panel="true">
                    <div class="octane-test-metrics-grid">
                      <j:forEach var="metric" items="${snapshot.testMetrics.cards}">
                        <article class="octane-test-metric-card octane-test-metric-${metric.key}"
                            data-test-metric-key="${metric.key}">
                          <div class="octane-test-metric-heading">
                            <j:choose>
                              <j:when test="${metric.icon == 'chart'}">
                                <svg class="octane-test-metric-icon" viewBox="0 0 24 24"
                                    aria-hidden="true">
                                  <path d="M4 20h16" />
                                  <path d="M6 16v-5" />
                                  <path d="M12 16V7" />
                                  <path d="M18 16v-9" />
                                </svg>
                              </j:when>
                              <j:when test="${metric.icon == 'activity'}">
                                <svg class="octane-test-metric-icon" viewBox="0 0 24 24"
                                    aria-hidden="true">
                                  <path d="M4 12h4l2-6 4 12 2-6h4" />
                                </svg>
                              </j:when>
                              <j:when test="${metric.icon == 'defect'}">
                                <svg class="octane-test-metric-icon" viewBox="0 0 24 24"
                                    aria-hidden="true">
                                  <path d="M12 3l9 16H3z" />
                                  <path d="M12 9v4" />
                                  <path d="M12 17h.01" />
                                </svg>
                              </j:when>
                              <j:otherwise>
                                <svg class="octane-test-metric-icon" viewBox="0 0 24 24"
                                    aria-hidden="true">
                                  <circle cx="12" cy="13" r="8" />
                                  <path d="M12 9v4l3 2" />
                                  <path d="M9 2h6" />
                                </svg>
                              </j:otherwise>
                            </j:choose>
                            <span>${metric.title}</span>
                          </div>
                          <div class="octane-test-metric-value">${metric.value}</div>
                          <div class="octane-test-metric-detail">${metric.detail}</div>
                          <div class="octane-test-metric-trend octane-test-metric-trend-${metric.trendTone}">
                            ${metric.trendText}
                          </div>
                        </article>
                      </j:forEach>
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <section class="octane-chart-card octane-timer-card" draggable="true"
                data-card-key="timer-poll"
                data-octane-timer="poll"
                data-total-seconds="${snapshot.refreshSeconds}"
                data-started-at="${snapshot.updatedAt}"
                data-updated-at="${snapshot.updatedAt}"
                data-active="${snapshot.building}"
                data-active-view="timer">
              <div class="octane-card-actions">
                <j:if test="${snapshot.riskHeatMapEnabled}">
                  <button class="octane-view-toggle" type="button"
                      data-target-view="heatmap" data-target-view-label="risk heat map"
                      aria-label="Show risk heat map" title="Show risk heat map">
                    <svg class="octane-action-icon octane-icon-heatmap" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <path d="M4 4h6v6H4z" />
                      <path d="M14 4h6v6h-6z" />
                      <path d="M4 14h6v6H4z" />
                      <path d="M14 14h6v6h-6z" />
                    </svg>
                    <svg class="octane-action-icon octane-icon-timer" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <circle cx="12" cy="13" r="8" />
                      <path d="M12 9v4l3 2" />
                      <path d="M9 2h6" />
                    </svg>
                  </button>
                </j:if>
                <button class="octane-expand-toggle" type="button" aria-label="Expand widget"
                    aria-expanded="false" title="Expand widget">
                  <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M8 4H4v4" />
                    <path d="M16 4h4v4" />
                    <path d="M20 16v4h-4" />
                    <path d="M8 20H4v-4" />
                  </svg>
                  <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M9 3v6H3" />
                    <path d="M3 9l6-6" />
                    <path d="M15 21v-6h6" />
                    <path d="M21 15l-6 6" />
                  </svg>
                </button>
                <button class="octane-card-tools" type="button"
                    aria-label="Move widget"
                    title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                  <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                      focusable="false">
                    <circle cx="12" cy="5" r="2" />
                    <circle cx="12" cy="12" r="2" />
                    <circle cx="12" cy="19" r="2" />
                  </svg>
                </button>
              </div>
              <div class="octane-flip-viewport">
                <div class="octane-flip-face octane-flip-face-timer" data-card-view="timer">
                  <div class="octane-flip-face-header">
                    <div>
                      <h2 class="octane-card-title">Status Check</h2>
                      <j:choose>
                        <j:when test="${snapshot.building}">
                          <div class="octane-muted" data-live-update-line="true">
                            <span data-live-update-title="true">Polling interval</span>
                            <span class="octane-live-update" data-live-update-status="true"></span>
                          </div>
                        </j:when>
                        <j:otherwise>
                          <div class="octane-muted octane-live-update-last-updated"
                              data-live-update-line="true">
                            <span data-live-update-title="true">
                              LAST UPDATED: ${snapshot.updatedAtText}
                            </span>
                            <span class="octane-live-update" data-live-update-status="true"></span>
                          </div>
                        </j:otherwise>
                      </j:choose>
                    </div>
                  </div>
                  <div class="octane-flip-face-body">
                    <div class="octane-timer-wrap">
                      <svg class="octane-timer-donut" viewBox="0 0 240 240" role="img"
                          aria-label="Status Check">
                        <defs>
                          <linearGradient id="octane-poll-gradient" x1="32" y1="208" x2="208"
                              y2="32" gradientUnits="userSpaceOnUse">
                            <stop data-timer-tail-stop="true" data-timer-gradient-stop="true"
                                offset="0%" stop-color="#757575" />
                            <stop data-timer-gradient-stop="true" offset="20%"
                                stop-color="#696969" />
                            <stop data-timer-mid-stop="true" data-timer-gradient-stop="true"
                                offset="40%" stop-color="#5d5d5d" />
                            <stop data-timer-gradient-stop="true" offset="60%"
                                stop-color="#bbdefb" />
                            <stop data-timer-gradient-stop="true" offset="80%"
                                stop-color="#a8c7e1" />
                            <stop data-timer-head-stop="true" data-timer-gradient-stop="true"
                                offset="100%" stop-color="#95b1c8" />
                          </linearGradient>
                        </defs>
                        <circle class="octane-timer-track" cx="120" cy="120" r="84" />
                        <circle class="octane-timer-progress-halo" data-timer-progress-halo="true"
                            cx="120" cy="120" r="84" pathLength="100"
                            stroke="url(#octane-poll-gradient)" stroke-dasharray="0 100"
                            transform="rotate(-90 120 120)" />
                        <circle class="octane-timer-progress" data-timer-progress="true"
                            cx="120" cy="120" r="84" pathLength="100"
                            stroke="url(#octane-poll-gradient)" stroke-dasharray="0 100"
                            transform="rotate(-90 120 120)" />
                        <circle class="octane-timer-head" data-timer-head="true"
                            cx="120" cy="36" r="9.6" fill="#1f5fff" />
                        <text class="octane-timer-value" data-timer-value="true" x="120" y="118">
                          --
                        </text>
                        <text class="octane-timer-unit" data-timer-unit="true" x="120" y="132.4">
                          seconds
                        </text>
                      </svg>
                    </div>
                  </div>
                </div>
                <div class="octane-flip-face octane-flip-face-heatmap" data-card-view="heatmap">
                  <div class="octane-flip-face-header">
                    <div>
                      <h2 class="octane-card-title">Risk Heat Map</h2>
                      <div class="octane-muted octane-heatmap-subtitle-row">
                        <span class="octane-heatmap-inline-legend">
                          <span class="octane-legend-row">
                            <span class="octane-swatch" style="background:#009900"></span>Low
                          </span>
                          <span class="octane-legend-row">
                            <span class="octane-swatch" style="background:#4391F5"></span>Moderate
                          </span>
                          <span class="octane-legend-row">
                            <span class="octane-swatch" style="background:#ffb74d"></span>Warning
                          </span>
                          <span class="octane-legend-row">
                            <span class="octane-swatch" style="background:#990000"></span>High
                          </span>
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="octane-flip-face-body" data-heat-map-panel="true">
                    <div class="octane-risk-heat-map-empty">
                      <j:choose>
                        <j:when test="${snapshot.riskHeatMapEnabled}">
                          Risk heat map will appear after the next report refresh.
                        </j:when>
                        <j:otherwise>
                          Risk heat map is disabled. Set riskHeatMap: true to fetch defect risk data.
                        </j:otherwise>
                      </j:choose>
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <section class="octane-chart-card octane-timer-card" draggable="true"
                data-card-key="progress-execution"
                data-octane-progress="execution"
                data-progress-value="${snapshot.executionProgress}">
              <div class="octane-card-header">
                <div>
                  <h2 class="octane-card-title">Execution Progress</h2>
                  <div class="octane-muted">All Testcase execution</div>
                </div>
                <div class="octane-card-actions">
                  <button class="octane-expand-toggle" type="button" aria-label="Expand widget"
                      aria-expanded="false" title="Expand widget">
                    <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <path d="M8 4H4v4" />
                      <path d="M16 4h4v4" />
                      <path d="M20 16v4h-4" />
                      <path d="M8 20H4v-4" />
                    </svg>
                    <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <path d="M9 3v6H3" />
                      <path d="M3 9l6-6" />
                      <path d="M15 21v-6h6" />
                      <path d="M21 15l-6 6" />
                    </svg>
                  </button>
                  <button class="octane-card-tools" type="button"
                      aria-label="Move widget"
                      title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                    <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                        focusable="false">
                      <circle cx="12" cy="5" r="2" />
                      <circle cx="12" cy="12" r="2" />
                      <circle cx="12" cy="19" r="2" />
                    </svg>
                  </button>
                </div>
              </div>
              <div class="octane-timer-wrap">
                <svg class="octane-timer-donut" viewBox="0 0 240 240" role="img"
                    aria-label="Execution Progress">
                  <defs>
                    <linearGradient id="octane-execution-progress-gradient" x1="32" y1="208"
                        x2="208" y2="32" gradientUnits="userSpaceOnUse">
                      <stop data-execution-gradient-stop="true" offset="0%"
                          stop-color="#fb4b4b" />
                      <stop data-execution-gradient-stop="true" offset="50%"
                          stop-color="#e14343" />
                      <stop data-execution-gradient-stop="true" offset="100%"
                          stop-color="#e14343" />
                    </linearGradient>
                  </defs>
                  <circle class="octane-timer-track" cx="120" cy="120" r="84" />
                  <circle class="octane-timer-progress-halo" data-execution-progress-halo="true"
                      data-progress-halo="true"
                      cx="120" cy="120" r="84" pathLength="100"
                      stroke="url(#octane-execution-progress-gradient)" stroke-dasharray="0 100"
                      transform="rotate(-90 120 120)" />
                  <circle class="octane-timer-progress" data-execution-progress-circle="true"
                      data-progress-circle="true"
                      cx="120" cy="120" r="84" pathLength="100"
                      stroke="url(#octane-execution-progress-gradient)" stroke-dasharray="0 100"
                      transform="rotate(-90 120 120)" />
                  <circle class="octane-timer-head" data-execution-progress-head="true"
                      data-progress-head="true"
                      cx="120" cy="36" r="9.6" fill="#e14343" />
                  <text class="octane-timer-value" data-execution-progress-value="true"
                      data-progress-value-text="true" x="120" y="118">
                    ${snapshot.executionProgressText}
                  </text>
                  <text class="octane-timer-unit" x="120" y="132.4">
                    execution
                  </text>
                </svg>
              </div>
            </section>

            <section class="octane-chart-card octane-timer-card" draggable="true"
                data-card-key="progress-pass-rate"
                data-octane-progress="pass-rate"
                data-progress-value="${snapshot.passRateProgress}">
              <div class="octane-card-header">
                <div>
                  <h2 class="octane-card-title">Execution Pass Rate</h2>
                  <div class="octane-muted" data-pass-rate-label="true">
                    ${snapshot.passRateLabel}
                  </div>
                </div>
                <div class="octane-card-actions">
                  <button class="octane-expand-toggle" type="button" aria-label="Expand widget"
                      aria-expanded="false" title="Expand widget">
                    <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <path d="M8 4H4v4" />
                      <path d="M16 4h4v4" />
                      <path d="M20 16v4h-4" />
                      <path d="M8 20H4v-4" />
                    </svg>
                    <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <path d="M9 3v6H3" />
                      <path d="M3 9l6-6" />
                      <path d="M15 21v-6h6" />
                      <path d="M21 15l-6 6" />
                    </svg>
                  </button>
                  <button class="octane-card-tools" type="button"
                      aria-label="Move widget"
                      title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                    <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                        focusable="false">
                      <circle cx="12" cy="5" r="2" />
                      <circle cx="12" cy="12" r="2" />
                      <circle cx="12" cy="19" r="2" />
                    </svg>
                  </button>
                </div>
              </div>
              <div class="octane-timer-wrap">
                <svg class="octane-timer-donut" viewBox="0 0 240 240" role="img"
                    aria-label="Execution Pass Rate">
                  <defs>
                    <linearGradient id="octane-pass-rate-progress-gradient" x1="32" y1="208"
                        x2="208" y2="32" gradientUnits="userSpaceOnUse">
                      <stop data-progress-gradient-stop="true" offset="0%" stop-color="#fb4b4b" />
                      <stop data-progress-gradient-stop="true" offset="50%"
                          stop-color="#e14343" />
                      <stop data-progress-gradient-stop="true" offset="100%"
                          stop-color="#e14343" />
                    </linearGradient>
                  </defs>
                  <circle class="octane-timer-track" cx="120" cy="120" r="84" />
                  <circle class="octane-timer-progress-halo" data-progress-halo="true"
                      cx="120" cy="120" r="84" pathLength="100"
                      stroke="url(#octane-pass-rate-progress-gradient)" stroke-dasharray="0 100"
                      transform="rotate(-90 120 120)" />
                  <circle class="octane-timer-progress" data-progress-circle="true"
                      cx="120" cy="120" r="84" pathLength="100"
                      stroke="url(#octane-pass-rate-progress-gradient)" stroke-dasharray="0 100"
                      transform="rotate(-90 120 120)" />
                  <circle class="octane-timer-head" data-progress-head="true"
                      cx="120" cy="36" r="9.6" fill="#e14343" />
                  <text class="octane-timer-value" data-progress-value-text="true"
                      x="120" y="118">
                    ${snapshot.passRateProgressText}
                  </text>
                  <text class="octane-timer-unit" x="120" y="132.4">
                    passed
                  </text>
                </svg>
              </div>
            </section>
          </div>

          <div class="octane-report-zone octane-card-zone" id="octane-report-zone"
              data-zone-key="reports">
            <j:choose>
              <j:when test="${snapshot.hasReportSections()}">
                <j:forEach var="section" items="${snapshot.reportSections}">
                  <section class="octane-chart-card" draggable="true"
                      data-card-key="distribution-${section.source}">
                    <div class="octane-card-header">
                      <div>
                        <h2 class="octane-card-title">${section.statusDistributionTitle}</h2>
                        <div class="octane-distribution-meta">
                          <span class="octane-total-label">Total: ${section.metrics.total}</span>
                          <div class="octane-legend">
                            <j:forEach var="status" items="${section.totals}">
                              <j:if test="${status.count > 0}">
                                <div class="octane-legend-row">
                                  <span class="octane-swatch"
                                      style="background: ${status.color};"></span>
                                  <span>${status.label}</span>
                                </div>
                              </j:if>
                            </j:forEach>
                          </div>
                        </div>
                      </div>
                      <div class="octane-card-actions">
                        <button class="octane-expand-toggle" type="button"
                            aria-label="Expand widget" aria-expanded="false"
                            title="Expand widget">
                          <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                              aria-hidden="true" focusable="false">
                            <path d="M8 4H4v4" />
                            <path d="M16 4h4v4" />
                            <path d="M20 16v4h-4" />
                            <path d="M8 20H4v-4" />
                          </svg>
                          <svg class="octane-action-icon octane-icon-collapse"
                              viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M9 3v6H3" />
                            <path d="M3 9l6-6" />
                            <path d="M15 21v-6h6" />
                            <path d="M21 15l-6 6" />
                          </svg>
                        </button>
                        <button class="octane-card-tools" type="button"
                            aria-label="Move widget"
                            title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                          <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                              focusable="false">
                            <circle cx="12" cy="5" r="2" />
                            <circle cx="12" cy="12" r="2" />
                            <circle cx="12" cy="19" r="2" />
                          </svg>
                        </button>
                      </div>
                    </div>
                    <div class="octane-donut-wrap">
                      <svg class="octane-donut" viewBox="-10 -10 120 120" role="img"
                          aria-label="${section.statusDistributionTitle}">
                        <title>${section.statusDistributionTitle}</title>
                        <j:forEach var="slice" items="${section.pieSlices}">
                          <j:choose>
                            <j:when test="${slice.fullCircle}">
                              <circle cx="50" cy="50" r="46" fill="${slice.color}">
                                <title>${slice.title}</title>
                              </circle>
                            </j:when>
                            <j:otherwise>
                              <path d="${slice.path}" fill="${slice.color}">
                                <title>${slice.title}</title>
                              </path>
                            </j:otherwise>
                          </j:choose>
                        </j:forEach>
                        <circle class="octane-donut-hole" cx="50" cy="50" r="30" />
                        <j:forEach var="slice" items="${section.pieSlices}">
                          <text class="octane-donut-label" x="${slice.labelX}"
                              y="${slice.labelY}" dominant-baseline="central">
                            ${slice.percentageLabel}
                          </text>
                        </j:forEach>
                      </svg>
                    </div>
                    <table class="octane-chart-data-summary octane-visually-hidden">
                      <caption>${section.statusDistributionTitle}</caption>
                      <thead>
                        <tr>
                          <th scope="col">Status</th>
                          <th scope="col">Count</th>
                          <th scope="col">Percent</th>
                        </tr>
                      </thead>
                      <tbody>
                        <j:forEach var="status" items="${section.totals}">
                          <j:if test="${status.count > 0}">
                            <tr>
                              <th scope="row">${status.label}</th>
                              <td>${status.count}</td>
                              <td>${status.percentageLabel}</td>
                            </tr>
                          </j:if>
                        </j:forEach>
                      </tbody>
                    </table>
                  </section>

                  <section class="octane-chart-card" draggable="true"
                      data-card-key="bars-${section.source}">
                    <div class="octane-card-header">
                      <div>
                        <h2 class="octane-card-title">${section.suiteRunChartTitle}</h2>
                        <div class="octane-suite-chart-meta">
                          <span class="octane-total-label">
                            Total Suiteruns: ${section.suiteRunCount}
                          </span>
                          <div class="octane-legend">
                            <j:forEach var="status" items="${section.totals}">
                              <j:if test="${status.count > 0}">
                                <span class="octane-legend-row">
                                  <span class="octane-swatch"
                                      style="background: ${status.color};"></span>
                                  <span>${status.label}</span>
                                </span>
                              </j:if>
                            </j:forEach>
                          </div>
                        </div>
                      </div>
                      <div class="octane-card-actions">
                        <button class="octane-expand-toggle" type="button"
                            aria-label="Expand widget" aria-expanded="false"
                            title="Expand widget">
                          <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                              aria-hidden="true" focusable="false">
                            <path d="M8 4H4v4" />
                            <path d="M16 4h4v4" />
                            <path d="M20 16v4h-4" />
                            <path d="M8 20H4v-4" />
                          </svg>
                          <svg class="octane-action-icon octane-icon-collapse"
                              viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M9 3v6H3" />
                            <path d="M3 9l6-6" />
                            <path d="M15 21v-6h6" />
                            <path d="M21 15l-6 6" />
                          </svg>
                        </button>
                        <button class="octane-card-tools" type="button"
                            aria-label="Move widget"
                            title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                          <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                              focusable="false">
                            <circle cx="12" cy="5" r="2" />
                            <circle cx="12" cy="12" r="2" />
                            <circle cx="12" cy="19" r="2" />
                          </svg>
                        </button>
                      </div>
                    </div>
                    <div class="octane-bar-graph">
                      <div class="octane-y-axis-label">Test Runs</div>
                      <div class="octane-y-axis-scale">
                        <j:forEach var="tick" items="${section.yAxisTicks}">
                          <span class="octane-axis-value">${tick}</span>
                        </j:forEach>
                      </div>
                      <div class="octane-bar-plot"
                          style="--octane-grid-line-count: ${section.yAxisGridLineCount};">
                        <div class="octane-vertical-bars">
                          <j:forEach var="suiteRun" items="${section.suiteRuns}">
                            <div class="octane-suite-column" tabindex="0"
                                data-card-key="bars-${section.source}"
                                data-bar-key="${suiteRun.suiteRunId}"
                                data-dominant-status-color="${suiteRun.dominantStatusColor}"
                                data-dominant-status-label="${suiteRun.dominantStatusLabel}"
                                aria-label="${suiteRun.title}">
                              <div class="octane-vertical-bar-wrap">
                                <div class="octane-vertical-bar" style="${suiteRun.barHeightStyle}">
                                  <j:forEach var="status" items="${suiteRun.statuses}">
                                    <j:if test="${status.count > 0}">
                                      <span class="octane-vertical-segment"
                                          style="${status.heightStyle}"></span>
                                    </j:if>
                                  </j:forEach>
                                </div>
                              </div>
                              <span class="octane-suite-label" title="${suiteRun.title}">
                                ${suiteRun.axisLabel}
                              </span>
                              <div class="octane-bar-popup" role="tooltip">
                                <div class="octane-bar-popup-name">${suiteRun.displayName}</div>
                                <j:forEach var="status" items="${suiteRun.statuses}">
                                  <j:if test="${status.count > 0}">
                                    <div class="octane-bar-popup-row">
                                      <span class="octane-swatch"
                                          style="background: ${status.color};"></span>
                                      <span class="octane-bar-popup-label">${status.label}</span>
                                      <span class="octane-bar-popup-value">${status.count}</span>
                                      <span class="octane-bar-popup-percent">
                                        (${status.percentageLabel})
                                      </span>
                                    </div>
                                  </j:if>
                                </j:forEach>
                                <div class="octane-bar-popup-total">
                                  <span>Total</span>
                                  <span class="octane-bar-popup-total-value">${suiteRun.total}</span>
                                </div>
                              </div>
                            </div>
                          </j:forEach>
                        </div>
                      </div>
                    </div>
                    <table class="octane-chart-data-summary octane-visually-hidden">
                      <caption>${section.suiteRunChartTitle}</caption>
                      <thead>
                        <tr>
                          <th scope="col">Run by</th>
                          <th scope="col">Status</th>
                          <th scope="col">Count</th>
                          <th scope="col">Percent</th>
                          <th scope="col">Total</th>
                        </tr>
                      </thead>
                      <tbody>
                        <j:forEach var="suiteRun" items="${section.suiteRuns}">
                          <j:forEach var="status" items="${suiteRun.statuses}">
                            <j:if test="${status.count > 0}">
                              <tr>
                                <th scope="row">${suiteRun.displayName}</th>
                                <td>${status.label}</td>
                                <td>${status.count}</td>
                                <td>${status.percentageLabel}</td>
                                <td>${suiteRun.total}</td>
                              </tr>
                            </j:if>
                          </j:forEach>
                        </j:forEach>
                      </tbody>
                    </table>
                  </section>
                </j:forEach>
              </j:when>
              <j:when test="${!snapshot.hasSections()}">
                <section class="octane-chart-card" draggable="true"
                    data-card-key="suite-run-empty">
                  <div class="octane-card-header">
                    <div>
                      <h2 class="octane-card-title">Suite run charts</h2>
                      <div class="octane-muted">${snapshot.stateLabel}</div>
                    </div>
                    <div class="octane-card-actions">
                      <button class="octane-expand-toggle" type="button"
                          aria-label="Expand widget" aria-expanded="false" title="Expand widget">
                        <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                            aria-hidden="true" focusable="false">
                          <path d="M8 4H4v4" />
                          <path d="M16 4h4v4" />
                          <path d="M20 16v4h-4" />
                          <path d="M8 20H4v-4" />
                        </svg>
                        <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                            aria-hidden="true" focusable="false">
                          <path d="M9 3v6H3" />
                          <path d="M3 9l6-6" />
                          <path d="M15 21v-6h6" />
                          <path d="M21 15l-6 6" />
                        </svg>
                      </button>
                      <button class="octane-card-tools" type="button"
                          aria-label="Move widget"
                          title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                        <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                            focusable="false">
                          <circle cx="12" cy="5" r="2" />
                          <circle cx="12" cy="12" r="2" />
                          <circle cx="12" cy="19" r="2" />
                        </svg>
                      </button>
                    </div>
                  </div>
                  <div class="octane-empty">${snapshot.emptyReportMessage}</div>
                </section>
              </j:when>
            </j:choose>
          </div>
        </div>
        <div id="octane-bar-popup-overlay" class="octane-bar-popup" role="tooltip"
            aria-hidden="true"></div>
      </div>
      <script>
        //<![CDATA[
        (function () {
          var dashboard = document.getElementById("octane-dashboard");
          if (!dashboard) {
            return;
          }
          var timerCards = dashboard.querySelectorAll("[data-octane-timer]");
          var progressCards = dashboard.querySelectorAll("[data-octane-progress]");
          var hasPerformanceClock =
              window.performance && typeof window.performance.now === "function";
          var requestFrame = window.requestAnimationFrame || function (callback) {
            return window.setTimeout(callback, 16);
          };
          var reducedMotionQuery =
              window.matchMedia ? window.matchMedia("(prefers-reduced-motion: reduce)") : null;
          function prefersReducedMotion() {
            return reducedMotionQuery && reducedMotionQuery.matches;
          }
          function scheduleTimerFrame(callback) {
            if (prefersReducedMotion()) {
              return window.setTimeout(callback, 1000);
            }
            return requestFrame(callback);
          }
          var snapshotUrl = dashboard.getAttribute("data-snapshot-url") || "snapshot";
          var currentUpdatedAt = dashboard.getAttribute("data-current-updated-at") || "";
          var stateLabel = document.querySelector("[data-report-state-label]");
          var updatedAtLabel = document.querySelector("[data-report-updated-at]");
          var messageLabel = document.querySelector("[data-report-message]");
          var liveUpdateLine = dashboard.querySelector("[data-live-update-line]");
          var liveUpdateTitle = dashboard.querySelector("[data-live-update-title]");
          var liveUpdateStatus = dashboard.querySelector("[data-live-update-status]");
          var reorderStatus = document.getElementById("octane-reorder-status");
          var liveRefresh = {
            fetching: false,
            retryDelayMillis: 500,
            stopped: dashboard.getAttribute("data-report-building") !== "true",
            waiting: false,
            waitingSince: 0
          };
          var TIMER_CENTER = 120;
          var TIMER_RADIUS = 84;
          var PROGRESS_COLOR_PHASES = {
            execution: [
              {limit: 5, colors: ["#fb4b4b", "#e14343"]},
              {limit: 30, colors: ["#ff7e5f", "#e57155", "#cc644c"]},
              {limit: 70, colors: ["#fff47f", "#e5db72", "#ccc365"]},
              {limit: 100, colors: ["#4bfb4b", "#43e143", "#3cc83c"]}
            ],
            passRate: [
              {limit: 20, colors: ["#fb4b4b", "#e14343"]},
              {limit: 60, colors: ["#ff7e5f", "#e57155", "#cc644c"]},
              {limit: 94, colors: ["#fff47f", "#e5db72", "#ccc365"]},
              {limit: 100, colors: ["#4bfb4b", "#43e143", "#3cc83c"]}
            ],
            poll: [
              {
                limit: 100,
                colors: ["#757575", "#696969", "#5d5d5d", "#bbdefb", "#a8c7e1", "#95b1c8"]
              }
            ],
            timeout: [
              {limit: 30, colors: ["#4caf50", "#449d48", "#3c8c40"]},
              {limit: 70, colors: ["#fff47f", "#e5db72", "#ccc365"]},
              {limit: 95, colors: ["#ff7e5f", "#e57155", "#cc644c"]},
              {limit: 100, colors: ["#fb4b4b", "#e14343"]}
            ]
          };
          var COMPLETE_PROGRESS_COLORS = {
            execution: "#3cc83c",
            passRate: "#3cc83c",
            poll: "#95b1c8",
            timeout: "#e14343"
          };
          var wallClockAnchor = Date.now();
          var performanceClockAnchor = hasPerformanceClock ? window.performance.now() : 0;
          function currentWallTime() {
            if (!hasPerformanceClock) {
              return Date.now();
            }
            return wallClockAnchor + window.performance.now() - performanceClockAnchor;
          }
          function parseTimestamp(value) {
            var parsed = Date.parse(value || "");
            return isNaN(parsed) ? currentWallTime() : parsed;
          }
          function clamp(value, minimum, maximum) {
            return Math.min(maximum, Math.max(minimum, value));
          }
          function trimNumber(value) {
            return value.toFixed(3).replace(/\.?0+$/, "");
          }
          function colorsForProgress(kind, progress) {
            var completeColor = COMPLETE_PROGRESS_COLORS[kind];
            if (progress >= 100 && completeColor) {
              return [completeColor, completeColor, completeColor];
            }
            var phases = PROGRESS_COLOR_PHASES[kind] || PROGRESS_COLOR_PHASES.timeout;
            for (var index = 0; index < phases.length; index += 1) {
              if (progress <= phases[index].limit) {
                return phases[index].colors;
              }
            }
            return phases[phases.length - 1].colors;
          }
          function stopColorAt(colors, index, stopCount) {
            if (colors.length === 0) {
              return "#4a4a4a";
            }
            if (stopCount <= 1 || colors.length === 1) {
              return colors[colors.length - 1];
            }
            var colorIndex = Math.round((index / (stopCount - 1)) * (colors.length - 1));
            return colors[clamp(colorIndex, 0, colors.length - 1)];
          }
          function applyGradientStops(stops, colors) {
            if (!stops) {
              return;
            }
            for (var index = 0; index < stops.length; index += 1) {
              stops[index].setAttribute("stop-color", stopColorAt(colors, index, stops.length));
            }
          }
          function formatLastUpdatedStatus(payload) {
            var value = payload && (payload.updatedAtText || payload.updatedAt);
            return "LAST UPDATED: " + (value || "UNKNOWN");
          }
          function setLiveUpdateStatus(message, isLastUpdated) {
            if (liveUpdateLine) {
              liveUpdateLine.classList.toggle(
                  "octane-live-update-last-updated", isLastUpdated === true);
            }
            if (liveUpdateTitle) {
              liveUpdateTitle.textContent =
                  isLastUpdated === true ? message || "" : "Polling interval";
            }
            if (liveUpdateStatus) {
              liveUpdateStatus.textContent = isLastUpdated === true ? "" : message || "";
            }
          }
          function htmlToElement(html) {
            var container = document.createElement("div");
            container.innerHTML = html || "";
            return container.querySelector("#octane-report-zone");
          }
          function createExpandButton() {
            var button = document.createElement("button");
            button.className = "octane-expand-toggle";
            button.type = "button";
            button.setAttribute("aria-label", "Expand widget");
            button.setAttribute("aria-expanded", "false");
            button.setAttribute("title", "Expand widget");
            button.innerHTML =
                '<svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"'
                + ' aria-hidden="true" focusable="false">'
                + '<path d="M8 4H4v4"></path><path d="M16 4h4v4"></path>'
                + '<path d="M20 16v4h-4"></path><path d="M8 20H4v-4"></path></svg>'
                + '<svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"'
                + ' aria-hidden="true" focusable="false">'
                + '<path d="M9 3v6H3"></path><path d="M3 9l6-6"></path>'
                + '<path d="M15 21v-6h6"></path><path d="M21 15l-6 6"></path></svg>';
            return button;
          }
          function createZoneFocusButton() {
            var button = document.createElement("button");
            button.className = "octane-zone-focus-toggle";
            button.type = "button";
            button.setAttribute("aria-label", "Expand section");
            button.setAttribute("aria-expanded", "false");
            button.setAttribute("title", "Expand section");
            button.innerHTML =
                '<svg class="octane-action-icon octane-icon-zone-expand" viewBox="0 0 24 24"'
                + ' aria-hidden="true" focusable="false">'
                + '<path d="M8 4H4v4"></path><path d="M16 4h4v4"></path>'
                + '<path d="M20 16v4h-4"></path><path d="M8 20H4v-4"></path></svg>';
            return button;
          }
          function setCardView(card, view) {
            if (!card) {
              return;
            }
            var button = card.querySelector(".octane-view-toggle");
            var targetView =
                button ? button.getAttribute("data-target-view") || "heatmap" : "heatmap";
            var targetLabel =
                button
                    ? button.getAttribute("data-target-view-label") || "risk heat map"
                    : "risk heat map";
            var nextView = view === targetView ? targetView : "timer";
            card.setAttribute("data-active-view", nextView);
            if (!button) {
              return;
            }
            var label = nextView === targetView ? "Show timer" : "Show " + targetLabel;
            button.setAttribute("aria-label", label);
            button.setAttribute("title", label);
          }
          function activeCardView(card) {
            return card ? card.getAttribute("data-active-view") || "timer" : "timer";
          }
          function toggleCardView(card) {
            var button = card ? card.querySelector(".octane-view-toggle") : null;
            var targetView = button ? button.getAttribute("data-target-view") || "heatmap" : "heatmap";
            setCardView(card, activeCardView(card) === targetView ? "timer" : targetView);
          }
          function initializeCardViews(root) {
            var cards = root.querySelectorAll("[data-active-view]");
            for (var index = 0; index < cards.length; index += 1) {
              setCardView(cards[index], activeCardView(cards[index]));
            }
          }
          function updateRiskHeatMap(payload) {
            if (!payload || typeof payload.riskHeatMapHtml !== "string") {
              return;
            }
            var panel = dashboard.querySelector("[data-heat-map-panel]");
            if (panel) {
              panel.innerHTML = payload.riskHeatMapHtml;
            }
          }
          function updateTestMetrics(payload) {
            if (!payload || typeof payload.testMetricsHtml !== "string") {
              return;
            }
            var panel = dashboard.querySelector("[data-test-metrics-panel]");
            if (panel) {
              panel.innerHTML = payload.testMetricsHtml;
            }
          }
          function currentReportPayload() {
            var executionProgressCard =
                dashboard.querySelector('[data-octane-progress="execution"]');
            var executionProgress =
                executionProgressCard
                    ? parseFloat(executionProgressCard.getAttribute("data-progress-value") || "0")
                    : 0;
            return {
              building: dashboard.getAttribute("data-report-building") === "true",
              executionProgress: isNaN(executionProgress) ? 0 : executionProgress,
              stateLabel: stateLabel ? stateLabel.textContent : ""
            };
          }
          function autoShowHeatMapOnCompletion(payload) {
            var card = dashboard.querySelector('[data-card-key="timer-poll"]');
            if (!card || !card.querySelector(".octane-view-toggle")) {
              return;
            }
            if (activeCardView(card) === "heatmap") {
              return;
            }
            var progress =
                Number(payload && payload.executionProgress ? payload.executionProgress : 0);
            if (isNaN(progress)) {
              progress = 0;
            }
            var timedOut =
                payload && payload.building !== true && payload.stateLabel === "Timed out";
            if (timedOut || progress >= 100) {
              setCardView(card, "heatmap");
            }
          }
          function autoShowTestMetricsOnCompletion(payload) {
            var card = dashboard.querySelector('[data-card-key="timer-timeout"]');
            if (!card || !card.querySelector(".octane-view-toggle")) {
              return;
            }
            if (activeCardView(card) === "metrics") {
              return;
            }
            var progress =
                Number(payload && payload.executionProgress ? payload.executionProgress : 0);
            if (isNaN(progress)) {
              progress = 0;
            }
            if ((payload && payload.building !== true) || progress >= 100) {
              setCardView(card, "metrics");
            }
          }
          function zoneKeyFor(zone) {
            if (!zone) {
              return "";
            }
            if (zone.getAttribute("data-zone-key")) {
              return zone.getAttribute("data-zone-key");
            }
            if (zone.id === "octane-timer-zone") {
              return "timers";
            }
            if (zone.id === "octane-report-zone") {
              return "reports";
            }
            return "";
          }
          function decorateCardZones(root) {
            if (!root) {
              return;
            }
            var zones = [];
            if (root.id === "octane-timer-zone" || root.id === "octane-report-zone") {
              zones.push(root);
            }
            var nestedZones = root.querySelectorAll
                ? root.querySelectorAll("#octane-timer-zone, #octane-report-zone")
                : [];
            for (var nestedIndex = 0; nestedIndex < nestedZones.length; nestedIndex += 1) {
              zones.push(nestedZones[nestedIndex]);
            }
            for (var index = 0; index < zones.length; index += 1) {
              var zone = zones[index];
              var zoneKey = zoneKeyFor(zone);
              if (zoneKey) {
                zone.setAttribute("data-zone-key", zoneKey);
              }
              if (!zone.querySelector(".octane-zone-focus-toggle")) {
                zone.insertBefore(createZoneFocusButton(), zone.firstChild);
              }
            }
          }
          function removeZoneFocusButton(zone) {
            var button = zone ? zone.querySelector(".octane-zone-focus-toggle") : null;
            if (button) {
              button.remove();
            }
          }
          function restoreZoneFocusButton(zone) {
            if (!zone || zone.querySelector(".octane-zone-focus-toggle")) {
              return;
            }
            zone.insertBefore(createZoneFocusButton(), zone.firstChild);
          }
          function decorateReportZone(zone) {
            if (!zone) {
              return;
            }
            var cards = zone.querySelectorAll(".octane-chart-card");
            for (var index = 0; index < cards.length; index += 1) {
              var header = cards[index].querySelector(".octane-card-header");
              var tools = header ? header.querySelector(".octane-card-tools") : null;
              if (!header || !tools || header.querySelector(".octane-card-actions")) {
                continue;
              }
              var actions = document.createElement("div");
              actions.className = "octane-card-actions";
              header.insertBefore(actions, tools);
              actions.appendChild(createExpandButton());
              actions.appendChild(tools);
            }
          }
          decorateCardZones(dashboard);
          initializeCardViews(dashboard);
          autoShowHeatMapOnCompletion(currentReportPayload());
          autoShowTestMetricsOnCompletion(currentReportPayload());
          function createTimerState(card) {
            var totalSeconds = parseInt(card.getAttribute("data-total-seconds") || "1", 10);
            if (isNaN(totalSeconds)) {
              totalSeconds = 1;
            }
            var totalMillis = Math.max(1, totalSeconds) * 1000;
            var startedAt = parseTimestamp(card.getAttribute("data-started-at"));
            var updatedAt = parseTimestamp(card.getAttribute("data-updated-at"));
            var active = card.getAttribute("data-active") === "true";
            var mode = card.getAttribute("data-octane-timer");
            return {
              active: active,
              card: card,
              endAt: startedAt + totalMillis,
              gradientStops: card.querySelectorAll("[data-timer-gradient-stop]"),
              head: card.querySelector("[data-timer-head]"),
              lastDisplayedUnit: "",
              lastDisplayedValue: "",
              mode: mode,
              progressHalo: card.querySelector("[data-timer-progress-halo]"),
              progressCircle: card.querySelector("[data-timer-progress]"),
              title: card.querySelector("[data-timeout-title]"),
              totalMillis: totalMillis,
              unit: card.querySelector("[data-timer-unit]"),
              updatedAt: updatedAt,
              value: card.querySelector("[data-timer-value]")
            };
          }
          function remainingMillis(state, now) {
            if (!state.active && state.mode === "poll") {
              return 0;
            }
            var sampleTime = state.active ? now : state.updatedAt;
            return clamp(state.endAt - sampleTime, 0, state.totalMillis);
          }
          function testingTimeSpentMillis(state, now) {
            var sampleTime = state.active ? now : state.updatedAt;
            var elapsed = sampleTime - (state.endAt - state.totalMillis);
            return clamp(elapsed, 0, state.totalMillis);
          }
          function setTimeoutTitle(state) {
            if (state.mode !== "timeout" || !state.title) {
              return;
            }
            state.title.textContent = state.active ? "Testing Time Remaining" : "Testing Time";
          }
          function setTimerText(state, remaining) {
            if (!state.value || !state.unit) {
              return;
            }
            var displayValue;
            var displayUnit;
            if (!state.active && state.mode === "timeout") {
              var spentMinutes = Math.round(testingTimeSpentMillis(state, currentWallTime()) / 60000);
              displayValue = String(spentMinutes);
              displayUnit = displayValue === "1" ? "minute" : "minutes";
            } else if (remaining < 60000) {
              displayValue = String(Math.ceil(remaining / 1000));
              displayUnit = displayValue === "1" ? "second" : "seconds";
            } else {
              displayValue = String(Math.ceil(remaining / 60000));
              displayUnit = displayValue === "1" ? "minute" : "minutes";
            }
            if (displayValue !== state.lastDisplayedValue) {
              state.value.textContent = displayValue;
              state.lastDisplayedValue = displayValue;
            }
            if (displayUnit !== state.lastDisplayedUnit) {
              state.unit.textContent = displayUnit;
              state.lastDisplayedUnit = displayUnit;
            }
          }
          function updateTimer(state, now) {
            setTimeoutTitle(state);
            var remaining = remainingMillis(state, now);
            var elapsed = state.totalMillis - remaining;
            var progress = clamp((elapsed / state.totalMillis) * 100, 0, 100);
            var colors = colorsForProgress(state.mode, progress);
            if (state.progressCircle) {
              state.progressCircle.style.strokeDasharray = trimNumber(progress) + " 100";
              state.progressCircle.style.opacity = progress <= 0 ? "0" : "1";
            }
            if (state.progressHalo) {
              state.progressHalo.style.strokeDasharray = trimNumber(progress) + " 100";
              state.progressHalo.style.opacity = progress <= 0 ? "0" : "0.22";
            }
            applyGradientStops(state.gradientStops, colors);
            var headColor = colors[colors.length - 1];
            if (state.head) {
              var angle = (progress / 100) * Math.PI * 2 - Math.PI / 2;
              state.head.setAttribute(
                  "cx", trimNumber(TIMER_CENTER + TIMER_RADIUS * Math.cos(angle)));
              state.head.setAttribute(
                  "cy", trimNumber(TIMER_CENTER + TIMER_RADIUS * Math.sin(angle)));
              state.head.setAttribute("fill", headColor);
              state.head.style.display = progress <= 0 ? "none" : "block";
            }
            setTimerText(state, remaining);
          }
          var timers = [];
          var hasActiveTimer = false;
          for (var timerIndex = 0; timerIndex < timerCards.length; timerIndex += 1) {
            var state = createTimerState(timerCards[timerIndex]);
            timers.push(state);
            hasActiveTimer = hasActiveTimer || state.active;
          }
          var timerLoopRunning = false;
          function scheduleTimerAnimation() {
            if (timerLoopRunning) {
              return;
            }
            timerLoopRunning = true;
            scheduleTimerFrame(animateTimers);
          }
          function beginSnapshotRefresh(now) {
            if (liveRefresh.stopped || liveRefresh.fetching || liveRefresh.waiting) {
              return;
            }
            if (typeof window.fetch !== "function") {
              window.location.reload();
              return;
            }
            if (!liveRefresh.waiting) {
              liveRefresh.waiting = true;
              liveRefresh.waitingSince = now;
              setLiveUpdateStatus("...", false);
            }
            fetchSnapshot();
            scheduleTimerAnimation();
          }
          function scheduleSnapshotRetry() {
            if (liveRefresh.stopped) {
              return;
            }
            window.setTimeout(fetchSnapshot, liveRefresh.retryDelayMillis);
          }
          function isFreshSnapshot(payload) {
            if (!payload) {
              return false;
            }
            return payload.updatedAt !== currentUpdatedAt || payload.building === false;
          }
          function resetPollTimer(payload) {
            var updatedAt = parseTimestamp(payload.updatedAt);
            var refreshSeconds = parseInt(payload.refreshSeconds || "1", 10);
            if (isNaN(refreshSeconds)) {
              refreshSeconds = 1;
            }
            for (var index = 0; index < timers.length; index += 1) {
              var state = timers[index];
              state.active = payload.building === true;
              state.updatedAt = updatedAt;
              state.card.setAttribute("data-active", String(state.active));
              state.card.setAttribute("data-updated-at", payload.updatedAt || "");
              if (state.mode === "poll") {
                state.totalMillis = Math.max(1, refreshSeconds) * 1000;
                state.endAt = updatedAt + state.totalMillis;
                state.card.setAttribute("data-total-seconds", String(refreshSeconds));
