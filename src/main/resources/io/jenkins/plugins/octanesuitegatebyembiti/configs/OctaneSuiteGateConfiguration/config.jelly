<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <style>
    .octane-suite-gate-section .jenkins-section__title::after {
      color: #737373;
      content: "${it.displayVersion}";
      font-size: 0.875rem;
      font-weight: 500;
      margin-left: 0.5rem;
      white-space: nowrap;
    }

    .octane-suite-gate-servers .octane-suite-gate-server-actions {
      display: flex;
      justify-content: flex-end;
      padding-bottom: 1rem;
    }

    .octane-suite-gate-servers .repeatable-add {
      margin-bottom: 1rem;
    }
  </style>
  <div class="octane-suite-gate-section">
    <f:section title="${it.displayName}">
      <div class="octane-suite-gate-servers">
        <f:repeatableProperty field="servers" add="Add server">
          <f:block>
            <div class="octane-suite-gate-server-actions">
              <f:repeatableDeleteButton value="Remove server" />
            </div>
          </f:block>
        </f:repeatableProperty>
      </div>
    </f:section>
  </div>
</j:jelly>
