pipeline {
  agent any

  environment {
    OCTANE_SHARED_SPACE_ID = '9016'
    OCTANE_WORKSPACE_ID = '4001'
    OCTANE_REGRESSION_SUITE_RUN_ID = '1196'
    OCTANE_PROJECT_NAME = 'Single Suite Run Project'
    OCTANE_DOMAIN_NAME = 'QUALITY_ENGINEERING'
    AUTOMATED_TESTING_TARGET = '80'
  }

  stages {
    stage('Build') {
      steps {
        echo 'Build or deploy your testable artifact here.'
      }
    }

    stage('Run Tests') {
      steps {
        echo 'Trigger the system that creates or updates the ALM Octane suite run here.'
      }
    }

    stage('Approve Octane Gate') {
      steps {
        input(
            message:
                "Continue and wait for ALM Octane regression suite run "
                    + "${env.OCTANE_REGRESSION_SUITE_RUN_ID}?",
            ok: 'Wait for Octane')
      }
    }

    stage('Wait For Octane Suite') {
      steps {
        catchError(
            buildResult: 'FAILURE',
          catchInterruptions: false,
          stageResult: 'FAILURE') {
          script {
          env.OCTANE_GATE_PASSED = 'false'
          // Accept numeric suite run IDs or "Release Name, Sprint Name".
          def suiteRunSource = (env.OCTANE_REGRESSION_SUITE_RUN_ID ?: '').trim()
          if (!suiteRunSource) {
            error 'OCTANE_REGRESSION_SUITE_RUN_ID must contain a suite run selection.'
          }

          Map gateResult =
              octaneSuiteGate(
                  serverId: 'octane-prod',
                  sharedSpaceId: env.OCTANE_SHARED_SPACE_ID,
                  workspaceId: env.OCTANE_WORKSPACE_ID,
                  suiteRunId: suiteRunSource,
                  // Defect groups and individual severity references are case-insensitive.
                  // Rates use open matching defects / total defects raised. The deduplicated total
                  // includes closed defects; append Count for a raw open count. Group and individual
                  // references are independent and do not duplicate defects inside either metric.
                  defectGroups: [
                    octaneDefectGroup(
                        name: 'major',
                        types: 'Critical, Very High, High, Unspecified'),
                    octaneDefectGroup(name: 'minor', types: 'Low, Medium')
                  ],
                  criteria:
                      '(regressions.executionRate == 100 AND regressions.passRate >= 95) '
                          + 'AND (defects.major < 10% AND defects.minor < 20%)',
                  pollIntervalSeconds: 30,
                  timeoutMinutes: 120,
                  timeoutMinutesExtended: 0,
                  basePassrateFigure: 95,
                  baseExecutionFigure: 100,
                  markUnstable: false,
                  riskHeatMap: true,
                  riskHeatMapDefectQuery: '',
                  riskHeatMapMaxDefects: 1000)

          env.OCTANE_GATE_PASSED = gateResult.passed == true ? 'true' : 'false'
          echo "Octane criteria verdict: ${gateResult.passed ? 'PASS' : 'FAIL'}"
          echo "Octane suite run IDs: ${gateResult.suiteRunIds.join(', ')}"
          echo "Regression execution rate: ${gateResult.regressions.executionRate}"
          echo "Regression pass rate: ${gateResult.regressions.passRate}"
          }
        }
      }
    }

    stage('Email Octane Report') {
      steps {
        octaneEmailReport(
            to: 'qa-team@example.com,dev-team@example.com',
            cc: 'qa-leads@example.com',
            bcc: 'qa-audit@example.com',
            projectName: env.OCTANE_PROJECT_NAME,
            domainName: env.OCTANE_DOMAIN_NAME,
            // For Gmail SMTP, use the same authenticated account or an authorized alias.
            from: 'jenkins-notifications@example.com',
            replyTo: 'qa-team@example.com',
            subject:
                "Octane Gate Report - ${env.JOB_NAME} Job #${env.BUILD_NUMBER} "
                    + 'Time {{DURATION}}',
            body: '''Hello Team,

The automated job for {{PROJECT_NAME}} tests has run for {{DURATION}} and is {{GATE_RESULT}}.

Set criteria: {{CRITERIA}}

Click here to {{REPORT_LINK}}.

See below the execution details:

{{EXECUTION_DETAILS}}

{{REPORT_SCREENSHOT}}

Thanks.
QA Automation Team''',
            onFailure: 'UNSTABLE',
            printDefectGroups: true,
            theme: 'DARK',
            viewportWidth: 1400,
            archiveScreenshot: true)
      }
    }

    stage('Deploy') {
      when {
        expression { env.OCTANE_GATE_PASSED == 'true' }
      }
      steps {
        echo 'Continue with the next stage once the Octane gate passes.'
      }
    }
  }
}
